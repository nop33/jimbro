{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jimbro-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-12",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "jimbro",
      "database_name": "jimbro",
      "database_id": "f94cbc4b-8004-4583-80c8-401e55730b40",
      "migrations_dir": "migrations"
    }
  ],
  // The public passkey routes (/auth/*) allow each client address 20 calls a minute, in each Cloudflare location.
  // A sign-up or a sign-in takes two calls.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
